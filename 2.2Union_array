class Solution {
public:
    // Function to return a list containing the union of the two arrays.
    vector<int> findUnion(vector<int>& a, vector<int>& b) {
        vector<int> result;
        int i = 0, j = 0;
        int n = a.size(), m = b.size();
        
        // Use two pointers to iterate through both arrays
        while (i < n && j < m) {
            // Skip duplicates in array 'a'
            if (i > 0 && a[i] == a[i - 1]) {
                i++;
                continue;
            }
            // Skip duplicates in array 'b'
            if (j > 0 && b[j] == b[j - 1]) {
                j++;
                continue;
            }

            if (a[i] < b[j]) {
                result.push_back(a[i]);
                i++;
            } else if (a[i] > b[j]) {
                result.push_back(b[j]);
                j++;
            } else {
                result.push_back(a[i]);
                i++;
                j++;
            }
        }

        // Append remaining elements in 'a'
        while (i < n) {
            if (i == 0 || a[i] != a[i - 1]) {
                result.push_back(a[i]);
            }
            i++;
        }

        // Append remaining elements in 'b'
        while (j < m) {
            if (j == 0 || b[j] != b[j - 1]) {
                result.push_back(b[j]);
            }
            j++;
        }

        return result;
    }
};
